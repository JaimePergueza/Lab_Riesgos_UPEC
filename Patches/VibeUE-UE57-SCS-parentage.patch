diff --git a/Source/VibeUE/Private/PythonAPI/UBlueprintService.cpp b/Source/VibeUE/Private/PythonAPI/UBlueprintService.cpp
index e791c85..6346113 100644
--- a/Source/VibeUE/Private/PythonAPI/UBlueprintService.cpp
+++ b/Source/VibeUE/Private/PythonAPI/UBlueprintService.cpp
@@ -879,3 +879,6 @@ bool UBlueprintService::AddComponent(
-			// CRITICAL: Call SetParent to properly set ParentComponentOrVariableName
-			// AddChildNode only manages the ChildNodes array, it does NOT set the parent reference
-			NewNode->SetParent(ParentNode);
+			// Local SCS parentage is serialized by the ChildNodes hierarchy. The
+			// ParentComponent* fields are reserved for inherited/native parents;
+			// setting both representations triggers the UE 5.7 SCS fixup ensure.
+			NewNode->ParentComponentOrVariableName = NAME_None;
+			NewNode->ParentComponentOwnerClassName = NAME_None;
+			NewNode->bIsParentComponentNative = false;
@@ -1353,2 +1356,3 @@ bool UBlueprintService::SetRootComponent(
-		// CRITICAL: Call SetParent to properly set ParentComponentOrVariableName
-		CurrentRootNode->SetParent(NewRootNode);
+		CurrentRootNode->ParentComponentOrVariableName = NAME_None;
+		CurrentRootNode->ParentComponentOwnerClassName = NAME_None;
+		CurrentRootNode->bIsParentComponentNative = false;
@@ -1366,2 +1370,3 @@ bool UBlueprintService::SetRootComponent(
-			// CRITICAL: Call SetParent to properly set ParentComponentOrVariableName
-			Child->SetParent(NewRootNode);
+			Child->ParentComponentOrVariableName = NAME_None;
+			Child->ParentComponentOwnerClassName = NAME_None;
+			Child->bIsParentComponentNative = false;
@@ -1580,3 +1585,6 @@ bool UBlueprintService::ReparentComponent(
-	// CRITICAL: Call SetParent to properly set ParentComponentOrVariableName
-	// AddChildNode only manages the ChildNodes array, it does NOT set the parent reference
-	NodeToReparent->SetParent(NewParent);
+	// Both nodes belong to this Blueprint's SCS, so ChildNodes is the source
+	// of truth. Clear inherited/native parent metadata to avoid serializing
+	// the same local relationship twice (UE 5.7 SimpleConstructionScript.cpp:474).
+	NodeToReparent->ParentComponentOrVariableName = NAME_None;
+	NodeToReparent->ParentComponentOwnerClassName = NAME_None;
+	NodeToReparent->bIsParentComponentNative = false;
